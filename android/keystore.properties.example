# Copy this file to android/keystore.properties and fill in your values.
# android/keystore.properties is in .gitignore and must never be committed.
#
# Generate a keystore if you don't have one:
#   keytool -genkeypair -v \
#     -keystore android/app/noring-release.keystore \
#     -alias noring \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -storepass YOUR_STORE_PASS \
#     -keypass YOUR_KEY_PASS \
#     -dname "CN=NoRing, OU=Mobile, O=YourOrg, L=Paris, ST=IDF, C=FR"

storeFile=noring-release.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=noring
keyPassword=YOUR_KEY_PASSWORD
